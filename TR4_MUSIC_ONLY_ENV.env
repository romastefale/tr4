# Obrigatórias
TR3_TELEGRAM_BOT_TOKEN=
TR3_BASE_URL=https://SEU-DOMINIO.railway.app

# SQLite persistente no Railway
TR3_DATABASE_URL=sqlite:////app/data/tr4_music.sqlite3

# Música / APIs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Opcional
TR3_COMMAND_RATE_LIMIT_ENABLED=true
TR3_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
TR3_COMMAND_RATE_LIMIT_STANDARD_PER_WINDOW=12
TR3_COMMAND_RATE_LIMIT_EXPENSIVE_PER_WINDOW=4

# Equalizador Mini App — fase 8 Release operacional
TR4_EQUALIZADOR_ENABLED=false
TR4_EQUALIZADOR_APP_NAME=equalizador
TR4_EQUALIZADOR_MAESTRO_IDS=
TR4_EQUALIZADOR_OPERADOR_IDS=
TR4_EQUALIZADOR_PALCO_IDS=
TR4_EQUALIZADOR_CANAIS=
TR4_EQUALIZADOR_HIDE_TECHNICAL_IDS=true
TR4_EQUALIZADOR_INITDATA_MAX_AGE_SECONDS=600
TR4_EQUALIZADOR_SESSION_TTL_SECONDS=900
TR4_EQUALIZADOR_RATE_LIMIT_PER_MINUTE=30


