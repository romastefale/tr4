# Obrigatórias
TR3_TELEGRAM_BOT_TOKEN=
TR3_BASE_URL=https://SEU-DOMINIO.railway.app

# SQLite persistente no Railway
TR3_DATABASE_URL=sqlite:////app/data/tr4_music.sqlite3

# Música / APIs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# Opcional
TR3_COMMAND_RATE_LIMIT_ENABLED=true
TR3_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
TR3_COMMAND_RATE_LIMIT_STANDARD_PER_WINDOW=12
TR3_COMMAND_RATE_LIMIT_EXPENSIVE_PER_WINDOW=4

# Last.fm importação CSV owner-only (scrobble write API)
# Reusa TR3_LASTFM_API_KEY se você já tem no Railway; scrobble precisa também de secret + session key.
TR3_LASTFM_API_KEY=
TR3_LASTFM_API_SECRET=
TR3_LASTFM_SESSION_KEY=
TR3_LASTFM_SCROBBLE_IMPORT_MAX_FILE_BYTES=1000000
TR3_LASTFM_SCROBBLE_IMPORT_MAX_EXPANDED_ITEMS=50000
TR3_LASTFM_SCROBBLE_IMPORT_MAX_PER_JOB=2000
TR3_LASTFM_SCROBBLE_IMPORT_BATCH_SIZE=50
TR3_LASTFM_SCROBBLE_IMPORT_SLEEP_SECONDS=1.2
TR3_LASTFM_SCROBBLE_IMPORT_STAGE_SIZE=250
TR3_LASTFM_SCROBBLE_IMPORT_STAGE_SLEEP_SECONDS=10
TR3_LASTFM_SCROBBLE_IMPORT_SPACING_SECONDS=61
TR3_LASTFM_SCROBBLE_IMPORT_REQUIRE_CONFIRM=true
TR3_LASTFM_SCROBBLE_IMPORT_STOP_ON_DAILY_LIMIT=true
TR3_LASTFM_SCROBBLE_IMPORT_SEND_RETRY_CSV=true
TR3_LASTFM_SCROBBLE_IMPORT_SEND_REMAINING_CSV=true
