# TR3 final release candidate — template de variáveis
# Preencha apenas os valores necessários ao seu deploy.

# Obrigatórias
TR3_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TR3_BASE_URL=https://<seu-deploy>
TR3_ROOT_USER_ID=<seu-user-id>
TR3_DATABASE_URL=sqlite:////data/app.db

# Spotify/Last.fm
TR3_SPOTIFY_CLIENT_ID=<spotify-client-id>
TR3_SPOTIFY_CLIENT_SECRET=<spotify-client-secret>
TR3_SPOTIFY_SCOPES=user-read-currently-playing user-read-recently-played
TR3_LASTFM_API_KEY=<lastfm-api-key>
TR3_LASTFM_API_BASE_URL=

# Grupos e delegação inicial
TR3_MANAGED_GROUP_IDS=-1001234567890,-1009876543210
TR3_SECOND_MODERATOR_ID=0
TR3_THIRD_MODERATOR_ID=0
TR3_TIGRAORESPONDE_TARGET_CHAT_ID=0

# Segurança, panic e alertas
TR3_SECURITY_ALERT_CHAT_ID=<chat_id-ou-user_id>
TR3_AUDIT_LOG_CHAT_ID=0
TR3_SECURITY_ALERTS_ENABLED=true
TR3_SECURITY_MONITOR_ENABLED=true
TR3_SECURITY_MONITOR_INTERVAL_SECONDS=300
TR3_SECURITY_MONITOR_MAX_GROUPS=50
TR3_PANIC_MODE=normal
TR3_PANIC_STOP_SERVER=false
TR3_ANOMALY_WINDOW_SECONDS=300
TR3_ANOMALY_MAX_FORBIDDEN_WEBHOOKS=5
TR3_ANOMALY_MAX_PERMISSION_DENIED=10
TR3_SECURITY_AUDIT_VIEW_LIMIT=20

# Rate limit
TR3_COMMAND_RATE_LIMIT_ENABLED=true
TR3_COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
TR3_COMMAND_RATE_LIMIT_EXPENSIVE_PER_WINDOW=3
TR3_COMMAND_RATE_LIMIT_STANDARD_PER_WINDOW=10

# Radio
TR3_RADIO_SCHEDULER_ENABLED=true
TR3_RADIO_SCHEDULER_INTERVAL_SECONDS=60
TR3_RADIO_SCHEDULER_MAX_DUE_PER_TICK=10

# Sessões e locks
TR3_SESSION_PERSISTENCE_ENABLED=true
TR3_OPERATIONAL_LOCK_TTL_SECONDS=90

# Auditoria/exportação
TR3_AUDIT_EXPORT_LIMIT=1000
TR3_AUDIT_RETENTION_DAYS=90
TR3_CRITICAL_OPERATION_EXPORT_LIMIT=1000
TR3_CRITICAL_OPERATION_RETENTION_DAYS=180
TR3_AUDIT_EXPORT_ENCRYPTION_KEY=
TR3_AUDIT_EXPORT_ENCRYPTION_KEY_ID=current
TR3_AUDIT_EXPORT_DECRYPTION_KEYS=

# Performance/HTTP/Spotify avançado
TR3_HTTP_TIMEOUT_SECONDS=
TR3_SPOTIFY_HTTP_TIMEOUT_SECONDS=
TR3_SPOTIFY_CACHE_MAX_ENTRIES=
TR3_SPOTIFY_CACHE_TTL_SECONDS=
TR3_SPOTIFY_MAX_CONCURRENT_REQUESTS=
TR3_SPOTIFY_PER_USER_RATE_LIMIT=
TR3_SPOTIFY_RATE_LIMIT_WINDOW_SECONDS=
TR3_SPOTIFY_CIRCUIT_BREAKER_THRESHOLD=
TR3_SPOTIFY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=

# Canvas Spotify
TR3_SPOTIFY_CANVAS_ENABLED=
TR3_SPOTIFY_CANVAS_TIMEOUT_SECONDS=
TR3_SPOTIFY_CANVAS_SP_DC=
TR3_CANVAS_CACHE_ENABLED=
TR3_CANVAS_CACHE_CHANNEL_ID=

# Dados
TR3_DATA_DIR=/data

# Outras variáveis detectadas no settings.py
TR3_OWNER_ID=
