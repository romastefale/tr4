+def test_x9_rejects_colon_and_dash_forms() -> None:
+    from app.plugins.tigrao_fsm.parsers import parse_x9_query
+
+    assert parse_x9_query("x9") == ""
+    assert parse_x9_query("x9 alvo") == "alvo"
